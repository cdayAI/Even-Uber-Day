{
  "name": "even-uber-display",
  "version": "0.2.0",
  "type": "module",
  "description": "Even Hub display app for Even Uber - ride tracking on G2 AR glasses",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n vite,server \"npm:dev:vite\" \"npm:dev:server\" --kill-others",
    "dev:vite": "vite",
    "dev:server": "tsx watch server.ts",
    "dev:glasses": "concurrently -n vite,server \"vite --host 0.0.0.0\" \"npm:dev:server\" --kill-others",
    "qr": "evenhub qr --http --port 5173",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "lint": "npm run type-check",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "type-check:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && evenhub pack app.json dist -o EvenUber.ehpk"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^7.3.7",
    "vitest": "4.1.11"
  }
}
